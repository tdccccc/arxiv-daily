{
  "name": "@arxiv-daily/email-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker: Official delivery (Beta) for arXiv Daily digests",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy-with-identity.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "preflight": "node scripts/cutover-preflight.mjs"
  },
  "overrides": {
    "vite": "$vite",
    "source-map-js": "^1.2.2",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.8.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "wrangler": "^4.149.0"
  }
}
