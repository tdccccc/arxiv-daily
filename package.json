{
  "name": "arxiv-daily-workspace",
  "version": "0.6.4",
  "private": true,
  "description": "Workspace for the arXiv Daily Obsidian plugin and Node CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdccccc/arxiv-daily.git"
  },
  "homepage": "https://github.com/tdccccc/arxiv-daily#readme",
  "bugs": "https://github.com/tdccccc/arxiv-daily/issues",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "plugin"
  ],
  "scripts": {
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:product-units": "node scripts/check-product-units.mjs",
    "lint:obsidian": "eslint \"plugin/{main.ts,src/**/*.ts}\" manifest.json LICENSE --max-warnings=64",
    "lint": "npm run lint:obsidian",
    "lint:review": "eslint --config eslint.config.review.mjs . ; node scripts/check-css-review.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node scripts/run-root-tests.mjs",
    "test:workspaces": "npm run test --workspaces --if-present --",
    "test:desktop": "node scripts/desktop-acceptance/acceptance.mjs",
    "test:acceptance": "node scripts/acceptance/run.mjs",
    "test:acceptance:tools": "node --test scripts/tests/acceptance-*.test.mjs",
    "build": "npm run build --workspaces --if-present",
    "smoke:build": "node scripts/smoke-build.mjs",
    "test:release-tools": "node --test scripts/tests/*.test.mjs && npm run check:product-units",
    "check:obsidian-submission": "node scripts/check-obsidian-submission.mjs",
    "smoke:install": "node scripts/install-smoke.mjs",
    "sync:release-version": "node scripts/sync-release-version.mjs",
    "check:release-version": "node scripts/check-release-version.mjs",
    "check:published-manifest": "node scripts/check-published-manifest.mjs",
    "cli": "node apps/cli/dist/arxiv-daily-cli.cjs"
  },
  "overrides": {
    "onnxruntime-node": "npm:empty-npm-package@1.0.0",
    "sharp": "npm:empty-npm-package@1.0.0",
    "vite": "$vite",
    "obsidian": {
      "moment": "2.31.0"
    },
    "source-map-js": "^1.2.2",
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^2.1.1",
    "@types/node": "^22.15.0",
    "@types/pako": "^2.0.3",
    "esbuild": "^0.25.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "linkedom": "^0.18.12",
    "obsidian": "^1.14.4",
    "playwright": "1.64.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
