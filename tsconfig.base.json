{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["DOM", "ES2022"],
    "baseUrl": ".",
    "paths": {
      "@arxiv-daily/core": ["packages/core/src/index.ts"],
      "@arxiv-daily/node-runtime": ["packages/node-runtime/src/index.ts"]
    }
  }
}
