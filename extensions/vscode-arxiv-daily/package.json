{
  "name": "arxiv-daily-vscode",
  "displayName": "arXiv Daily Companion",
  "description": "VS Code companion for arXiv Daily vaults and the shared paper index.",
  "version": "0.0.1",
  "publisher": "tdccccc",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onCommand:arxivDaily.openDashboard",
    "onCommand:arxivDaily.run",
    "onCommand:arxivDaily.runPending",
    "onCommand:arxivDaily.summarizeById",
    "onCommand:arxivDaily.configureApiKey"
  ],
  "contributes": {
    "commands": [
      {
        "command": "arxivDaily.openDashboard",
        "title": "arXiv Daily: Open Reading Dashboard"
      },
      {
        "command": "arxivDaily.run",
        "title": "arXiv Daily: Run for Today"
      },
      {
        "command": "arxivDaily.runPending",
        "title": "arXiv Daily: Run Pending Dates"
      },
      {
        "command": "arxivDaily.summarizeById",
        "title": "arXiv Daily: Summarize by arXiv ID"
      },
      {
        "command": "arxivDaily.configureApiKey",
        "title": "arXiv Daily: Configure API Key"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/check-package.mjs",
    "test": "node scripts/check-package.mjs && node scripts/workspace-adapter-test.mjs && node scripts/secret-adapter-test.mjs && node scripts/dashboard-test.mjs",
    "vsix:package": "npx @vscode/vsce package --out dist/arxiv-daily-vscode-${npm_package_version}.vsix"
  }
}
