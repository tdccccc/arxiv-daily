{
  "name": "arxiv-daily-vscode",
  "displayName": "arXiv Daily Companion",
  "description": "VS Code companion for arXiv Daily vaults and the shared paper index.",
  "version": "0.0.1",
  "publisher": "tdccccc",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onCommand:arxivDaily.openDashboard",
    "onCommand:arxivDaily.run",
    "onCommand:arxivDaily.summarizeById"
  ],
  "contributes": {
    "configuration": {
      "title": "arXiv Daily",
      "properties": {
        "arxivDaily.cliPath": {
          "type": "string",
          "default": "arxiv-daily",
          "description": "Executable name or path used to run the arXiv Daily Node CLI from VS Code."
        }
      }
    },
    "commands": [
      {
        "command": "arxivDaily.openDashboard",
        "title": "arXiv Daily: Open Reading Dashboard"
      },
      {
        "command": "arxivDaily.run",
        "title": "arXiv Daily: Run for Today"
      },
      {
        "command": "arxivDaily.summarizeById",
        "title": "arXiv Daily: Summarize by arXiv ID"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/check-package.mjs",
    "test": "node scripts/check-package.mjs && node scripts/workspace-adapter-test.mjs && node scripts/dashboard-test.mjs && node scripts/pipeline-commands-test.mjs && npm run smoke",
    "smoke": "node scripts/extension-smoke-test.mjs",
    "vsix:package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2"
  }
}
