{
  "name": "dsh-arxiv-daily",
  "version": "0.1.19",
  "description": "Read, filter and save research papers in the DSH sidebar with arXiv Daily",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdccccc/arxiv-daily.git",
    "directory": "extensions/dsh-arxiv-daily"
  },
  "homepage": "https://github.com/tdccccc/arxiv-daily/tree/main/extensions/dsh-arxiv-daily#readme",
  "bugs": "https://github.com/tdccccc/arxiv-daily/issues",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "arxiv",
    "research"
  ],
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
