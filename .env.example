# LLM
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=300

# 输出路径（日报和论文报告保存位置）
WORK_DIR=./output

# arXiv 分类和时区
ARXIV_CATEGORY=astro-ph
TIMEZONE=Asia/Shanghai

# 研究兴趣（供 LLM 筛选 prompt 使用，双引号内可直接换行）
# ⚠️ 必须改成你自己关心的方向，默认值是别人的研究话题
RESEARCH_INTERESTS="Describe your research interests here — what kinds of papers should the LLM look for?"

# 详细收录标准（符合条件的论文会生成单独的详细报告）
# ⚠️ 也必须改成你自己的标准
DETAIL_CRITERIA="Papers proposing or comparing new methods / catalogs / benchmarks"

# category → tag 映射 (JSON)
CATEGORY_TAG_MAP={"example":"example","other":"other"}

# category → 日报显示名称 (JSON)
CATEGORY_DISPLAY_MAP={"example":"Example Section","other":"Other"}

# 允许生成详细报告的 category (JSON 数组)
DETAIL_CATEGORIES=["example"]

# 内容提取限制（字符数）
SECTION_CHAR_LIMIT=8000
PAPER_CHAR_LIMIT=50000
DAILY_CHAR_LIMIT=400000

# 跳过的章节 / 高优先级章节 (JSON 数组，小写匹配)
SKIP_SECTIONS=["reference","bibliography","appendix","acknowledgement","acknowledgment","author contribution","data availability","conflict of interest","orcid"]
PRIORITY_SECTIONS=["abstract","conclusion","summary"]

# 请求间隔（秒），避免被 arXiv 封 IP
REQUEST_DELAY=3

# 轮询间隔（秒）和最大重试次数
POLL_INTERVAL=1800
MAX_RETRIES=16

# 日志（默认保存到脚本同目录 arxiv_daily.log）
LOG_LEVEL=INFO
LOG_FILE=

# 缓存（默认保存到脚本同目录 .cache/）
CACHE_DIR=
CACHE_EXPIRY_DAYS=7
